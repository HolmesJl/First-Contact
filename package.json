{
  "name": "first-contact",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "build": "npm run build -w client",
    "check:layout": "tsx shared/shipInterior.check.ts",
    "check:door": "tsx server/src/cabinDoor.check.ts",
    "check:controls": "tsx client/src/input/controlMath.check.ts",
    "smoke:characters": "tsx tools/character-persistence-smoke.ts",
    "smoke:scan": "tsx tools/scan-smoke.ts",
    "smoke:items": "tsx tools/items-smoke.ts",
    "smoke:steer": "node tools/steer-smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
